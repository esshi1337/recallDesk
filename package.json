{
  "name": "recall-desk",
  "productName": "Recall Desk",
  "version": "1.4.0",
  "description": "A private, offline certification study desk",
  "author": "Recall Desk",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "install:local": "npm run package && node scripts/install-local.mjs",
    "test:timeline": "npm run build && node scripts/timeline-smoke.mjs",
    "test:materials": "npm run build && node scripts/materials-smoke.mjs",
    "convert:agentforce": "node scripts/convert-agentforce.mjs",
    "build:browser": "tsc --noEmit && vite build --mode browser && node scripts/build-browser.mjs",
    "browser": "npm run build:browser && node scripts/serve-browser.mjs",
    "serve:browser": "node scripts/serve-browser.mjs",
    "new:study": "node --import tsx scripts/study-template.mjs new",
    "build:study": "node --import tsx scripts/study-template.mjs build",
    "test:browser": "npm run build:browser && node --import tsx scripts/browser-smoke.mjs",
    "test:mobile": "npm run build:browser && node scripts/mobile-smoke.mjs",
    "check": "tsc --noEmit",
    "test:desktop-launch": "npm run build && node scripts/desktop-launch.mjs",
    "test:templates": "npm run build && node scripts/templates-smoke.mjs",
    "test:agentforce": "node scripts/check-agentforce.mjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
